PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bookmyservice
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# For multiple allowed frontend origins, use comma-separated values:
# CLIENT_URL=http://localhost:5173,https://your-domain.com

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM_NAME=BookMyService
EMAIL_FROM_ADDRESS=your_email@gmail.com
EMAIL_TIMEZONE=Asia/Kolkata
EMAIL_CURRENCY=INR

ADMIN_EMAIL=admin@bookmyservice.com
ADMIN_PASSWORD=Admin@12345
