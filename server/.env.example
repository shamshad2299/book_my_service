BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM_NAME=BookMyService
EMAIL_FROM_ADDRESS=noreply@bookmyservice.com
EMAIL_TIMEZONE=Asia/Kolkata
EMAIL_CURRENCY=INR

ADMIN_EMAIL=admin@bookmyservice.com
ADMIN_PASSWORD=Admin@12345
